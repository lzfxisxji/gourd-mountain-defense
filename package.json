{
  "name": "gourd-mountain-defense",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "desktop:install": "node node_modules/electron/install.js",
    "build:exe": "electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --win --dir --x64",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "build:release": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.cjs",
  "description": "葫芦兄弟 · 守护葫芦山 离线塔防游戏",
  "author": "Gourd Mountain Defense",
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
